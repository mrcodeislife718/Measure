{
  "name": "measure-eval-os",
  "version": "0.1.0",
  "private": false,
  "description": "Architecture-neutral evaluation operating system for measuring intelligent systems, benchmarks, verifiers, and deployment trust.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && npm test",
    "test": "node --test dist/test/**/*.test.js",
    "demo": "npm run build && node dist/src/demo.js",
    "dev": "npx vercel dev",
    "deploy:preview": "npx vercel",
    "deploy:prod": "npx vercel --prod"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
